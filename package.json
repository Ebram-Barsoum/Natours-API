    "delete:tours": "tsx ./src/dev-data/data/initialize-collection-in-db.ts --delete tours",
    "import:users": "tsx ./src/dev-data/data/initialize-collection-in-db.ts --import users",
    "delete:users": "tsx ./src/dev-data/data/initialize-collection-in-db.ts --delete users",
    "import:reviews": "tsx ./src/dev-data/data/initialize-collection-in-db.ts --import reviews",
    "delete:reviews": "tsx ./src/dev-data/data/initialize-collection-in-db.ts --delete reviews",
    "build": "tsc && ts-add-js-extension --dir=dist",
    "start": "node dist/index.js",
    "start:prod": "cross-env NODE_ENV=production node dist/index.js",
    "debug": "ndb ./src/index.ts"
  },
